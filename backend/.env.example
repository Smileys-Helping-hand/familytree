# Environment Variables

# Server
PORT=5000
NODE_ENV=development

# Database - Neon/PostgreSQL (Primary Database)
DATABASE_URL=postgresql://username:password@host.neon.tech/dbname?sslmode=require

# JWT
JWT_SECRET=your_jwt_secret_key_change_this_in_production
JWT_REFRESH_SECRET=your_jwt_refresh_secret_change_this
JWT_EXPIRE=7d
JWT_REFRESH_EXPIRE=30d

# AI generation (choose one)
AI_PROVIDER=openai
OPENAI_API_KEY=your_openai_key
# AI_PROVIDER=gemini
# GEMINI_API_KEY=your_gemini_api_key

# Cloudinary (for image uploads)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Email (Resend preferred, or SendGrid/SMTP)
EMAIL_FROM=noreply@yourfamilytree.com
RESEND_API_KEY=re_your_resend_key
SENDGRID_API_KEY=your_sendgrid_key
# Or SMTP:
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your_email@gmail.com
# SMTP_PASS=your_password

# Stripe (optional - only needed when ENABLE_STRIPE=true)
ENABLE_STRIPE=false
STRIPE_SECRET_KEY=sk_test_your_stripe_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret
STRIPE_PREMIUM_PRICE_ID=price_premium_id
STRIPE_PREMIUM_PLUS_PRICE_ID=price_premium_plus_id

# Frontend URL (for CORS and email links)
FRONTEND_URL=http://localhost:5173

# File Upload
MAX_FILE_SIZE=10485760
# 10MB in bytes
